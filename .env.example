# Copie ce fichier en ".env" et renseigne tes identifiants.
# Le .env ne doit JAMAIS etre versionne (il est dans .gitignore).

# --- Bluesky ---
# Ton handle complet, ex : amelle.bsky.social
BLUESKY_HANDLE=ton-handle.bsky.social

# App Password (PAS ton mot de passe principal !)
# Genere-le dans Bluesky > Settings > Privacy and Security > App Passwords
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# --- (Optionnel) PostgreSQL pour passer de SQLite a Postgres ---
# DB_URL=postgresql://user:password@localhost:5432/thumalien
